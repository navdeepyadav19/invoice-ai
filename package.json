{
  "name": "invoice-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:types": "kysely-codegen --config-file .kysely-codegenrc.json --env-file .env.local --url 'env(DATABASE_URL_UNPOOLED)'",
    "postman:gen": "tsx scripts/generate-postman.ts",
    "postman:sync": "tsx scripts/sync-postman.ts",
    "openapi:gen": "tsx scripts/generate-openapi.ts",
    "api:key": "tsx scripts/create-api-key.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/functions": "^3.9.10",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.49.0",
    "mcp-handler": "^2.2.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.1.1"
