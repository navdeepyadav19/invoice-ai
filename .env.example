# Copy to .env.local and fill in.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects call this the anon key; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public origin, used to build shareable invoice links (/i/<token>).
# Leave unset locally; Vercel fills it in from VERCEL_URL on deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend → API Keys. Only needed once invoice emailing is wired up.
RESEND_API_KEY=re_
# Must be an address on a domain you have verified in Resend.
INVOICE_FROM_EMAIL="Invoices <invoices@yourdomain.com>"

# Sandbox (sandbox.co.in) → GST lookup during onboarding.
# Unset: onboarding still works, users just type their details in by hand.
SANDBOX_API_KEY=key_
SANDBOX_API_SECRET=secret_

# OpenAI → the "describe the invoice" box and the dictate button.
# Unset: the prompt box is hidden and the builder works exactly as before.
OPENAI_API_KEY=sk-

# ---------------------------------------------------------------------------
# Public API (/api/v1). Unset: the app works exactly as before, and every API
# request returns 401 rather than failing in a confusing way.
# ---------------------------------------------------------------------------

# Pepper for API key hashing. A long random string — `openssl rand -base64 48`.
# Kept OUT of the database on purpose: api_keys stores HMAC(pepper, secret), so
# a read-only leak of that table yields hashes nobody can check without this.
# Changing it invalidates every existing key.
API_KEY_PEPPER=

# Signing key for the short-lived JWTs that carry an API request's identity.
# Generate:  pnpm dlx supabase gen signing-key --algorithm ES256
# Then import the PUBLIC half in Supabase → Auth → Signing Keys, and put the
# private PEM here (literal \n escapes are fine) with its key id below.
#
# SECURITY: this is the most sensitive secret in the system. Anything holding it
# can mint a token for ANY user. Vercel encrypted env only, never committed.
SUPABASE_JWT_PRIVATE_KEY=
SUPABASE_JWT_KID=

# Webhook delivery worker (/api/cron/webhooks) only.
# The worker reads pending deliveries across ALL owners, which no user token can
# do. It calls two SECURITY DEFINER functions and never touches tenant tables.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Without it the delivery route refuses every request, including Vercel's.
CRON_SECRET=
