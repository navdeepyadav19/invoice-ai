# Copy to .env.local and fill in — or, with the Vercel project linked,
# `vercel env pull .env.local` fetches everything in the Neon block for you.
#
# ---------------------------------------------------------------------------
# Neon (Vercel → Storage → invoice-ai-db). Injected by the Vercel integration.
# ---------------------------------------------------------------------------

# Pooled endpoint (host contains -pooler). What the app queries through.
DATABASE_URL=postgresql://neondb_owner:...@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct endpoint. Used by `pnpm db:migrate` and `pnpm db:types` only:
# migrations take a session-level advisory lock, which a pooler can't hold.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (managed Better Auth). Users and sessions live in the neon_auth
# schema of the same database.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Signs the session cache cookie. 32+ characters: `openssl rand -base64 32`.
# Not injected by the integration — set it yourself, per environment.
NEON_AUTH_COOKIE_SECRET=

# Public origin, used to build shareable invoice links (/i/<token>).
# Leave unset locally. In Vercel set this to the production domain:
# https://invoice.horizonpay.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend → API Keys. Only needed once invoice emailing is wired up.
RESEND_API_KEY=re_
# Must be an address on a domain you have verified in Resend.
INVOICE_FROM_EMAIL="Invoices <invoices@yourdomain.com>"

# OpenAI → the "describe the invoice" box and the dictate button.
# Unset: the prompt box is hidden and the builder works exactly as before.
OPENAI_API_KEY=sk-

# ---------------------------------------------------------------------------
# Public API (/api/v1). Unset: the app works exactly as before, and every API
# request returns 401 rather than failing in a confusing way.
# ---------------------------------------------------------------------------

# Pepper for API key hashing. A long random string — `openssl rand -base64 48`.
# Kept OUT of the database on purpose: api_keys stores HMAC(pepper, secret), so
# a read-only leak of that table yields hashes nobody can check without this.
# Changing it invalidates every existing key.
API_KEY_PEPPER=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Without it the delivery route refuses every request, including Vercel's.
CRON_SECRET=
