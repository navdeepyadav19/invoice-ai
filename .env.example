# Copy to .env.local and fill in.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects call this the anon key; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public origin, used to build shareable invoice links (/i/<token>).
# Leave unset locally; Vercel fills it in from VERCEL_URL on deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend → API Keys. Only needed once invoice emailing is wired up.
RESEND_API_KEY=re_
# Must be an address on a domain you have verified in Resend.
INVOICE_FROM_EMAIL="Invoices <invoices@yourdomain.com>"

# Sandbox (sandbox.co.in) → GST lookup during onboarding.
# Unset: onboarding still works, users just type their details in by hand.
SANDBOX_API_KEY=key_
SANDBOX_API_SECRET=secret_

# OpenAI → the "describe the invoice" box and the dictate button.
# Unset: the prompt box is hidden and the builder works exactly as before.
OPENAI_API_KEY=sk-
