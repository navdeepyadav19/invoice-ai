{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Invoice-AI API",
  "description": "Developer documentation for the Invoice-AI REST API by HorizonPay: customers, products, prices, invoices and signed webhooks.",
  "colors": {
    "primary": "#454DB0",
    "light": "#8595F8",
    "dark": "#6B76E0"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://invoice.horizonpay.co"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://invoice.horizonpay.co/dashboard"
      },
      {
        "type": "github",
        "href": "https://github.com/navdeepyadav19/invoice-ai-sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://invoice.horizonpay.co/settings/api-keys"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Basics",
            "pages": [
              "authentication",
              "errors",
              "idempotency",
              "pagination",
              "rate-limits",
              "money-and-ids",
              "invoice-lifecycle"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks",
              "verify-webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.json"
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "cube",
        "groups": [
          {
            "group": "SDKs",
            "pages": [
              "sdks/node",
              "sdks/python"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "terminal",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/scripting-and-ci",
              "cli/commands"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "robot",
        "groups": [
          {
            "group": "MCP server",
            "pages": [
              "mcp/overview",
              "mcp/tools",
              "mcp/authentication",
              "mcp/safety"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "node",
        "python"
      ],
      "defaults": "required",
      "autogenerate": false
    },
    "mdx": {
      "server": "https://invoice.horizonpay.co/api/v1",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/navdeepyadav19/invoice-ai-sdk"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "Changelog",
            "href": "/changelog"
          },
          {
            "label": "Postman collection",
            "href": "/postman"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/navdeepyadav19/invoice-ai-sdk"
          }
        ]
      }
    ]
  },
