            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "description": "Permanent and one-way. Requires an `Idempotency-Key`; a retry replays the first response. Even without one, issuing twice returns the same number.",
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}/issue",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
